# Flutter / Dart generated files. Keep pubspec.lock for the application.
.dart_tool/
.packages
build/
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/
.widget_preview/
app.*.symbols
app.*.map.json
*.dart.js
*.dart.js.deps
*.dart.js.map
*.dart.js.info.json
*.js_

# Android and Apple generated/local files. Keep Gradle wrapper and lock files.
.gradle/
.cxx/
local.properties
key.properties
*.jks
*.keystore
/android/app/debug/
/android/app/profile/
/android/app/release/
Pods/
.symlinks/
**/xcuserdata/
**/DerivedData/
**/Flutter/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/Flutter/.last_build_id
**/Flutter/App.framework/
**/Flutter/Flutter.framework/
**/Flutter/Flutter.podspec
**/Runner/GeneratedPluginRegistrant.*

# Firebase local cache, logs and root-level emulator exports.
.firebase/
firebase-debug.log*
*-debug.log*
/firebase-export-*/
/emulator-data/
/emulator-exports/
# Deliberate fixtures in test/fixtures/ remain versioned.

# Local project selection/client config is regenerated by the Firebase owner.
# Client identifiers are not Admin secrets; this is the team's local-config convention.
.firebaserc
firebase_options.dart
google-services.json
GoogleService-Info.plist
firebase_app_id_file.json
# Keep firebase.json, firestore.rules, firestore.indexes.json and placeholders in config/.

# Private credentials. These folders are intentionally excluded in their entirety.
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
application_default_credentials.json
.runtimeconfig.json
.secret.local
credentials/
secrets/
config/*.local.json

# Safe placeholder templates (no actual credentials).
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!/config/service-account.example.json

# Node is used only for Firebase tooling and rule tests.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated test output. Keep tests, Maestro YAML and golden baselines.
/coverage/
/test-results/
/test-reports/
/test-artifacts/
test/**/failures/
.maestro/screenshots/
.maestro/videos/
.maestro/reports/
/profiling-output/
*.hprof
*.heapdump

# Local editor/OS files.
.idea/
*.iml
.DS_Store
Thumbs.db
*.swp
*.swo
